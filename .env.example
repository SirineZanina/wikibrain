# Copy to .env and fill in. Never commit .env.

# --- LLM (generation) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Embeddings ---
# "local"  -> sentence-transformers, runs in-process, no API key, no network
# "gemini" -> gemini-embedding-001 via the same key as generation
# Switching this changes the Chroma collection, which forces a clean re-ingest.
EMBEDDER=local
EMBED_MODEL_LOCAL=all-MiniLM-L6-v2
EMBED_MODEL_GEMINI=gemini-embedding-001
EMBED_DIM_GEMINI=768

# --- Retrieval tuning ---
TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Storage ---
COLLECTION_PREFIX=policies
# CHROMA_PATH=server/chroma

# --- API ---
CORS_ORIGINS=http://localhost:3000
# Set true to print the fully assembled prompt on every /chat call.
DEBUG_PROMPT=false

# --- Frontend (build-time; must be NEXT_PUBLIC_ to reach the browser) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
